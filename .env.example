# Node Environment
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mupost

# Redis (BullMQ & Cache & Rate Limiter)
REDIS_URL=redis://localhost:6379

# Security & Encryption (AES-256-GCM key: 32 bytes in hex = 64 characters)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NEXTAUTH_SECRET=supersecretjwtstringchangeinproduction123456

# Meta OAuth App Credentials
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# TikTok OAuth App Credentials
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Object Storage (S3 / MinIO)
S3_BUCKET=mupost-media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Public URL (Optional)
# App Port & Public URL
PORT=4829
NEXT_PUBLIC_APP_URL=http://localhost:4829
