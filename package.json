{
  "name": "mupost",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "all": "npm run dev:all",
    "dev:all": "bash scripts/dev-all.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --headed",
    "lhci": "lhci autorun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/lib/db/migrate.ts",
    "worker": "tsx --env-file=.env src/workers/index.ts",
    "worker:publish": "tsx --env-file=.env src/workers/publish-worker.ts",
    "worker:refresh": "tsx --env-file=.env src/workers/token-refresh-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/lib-storage": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@next/swc-linux-x64-gnu": "^16.3.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.1.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "14.2.35",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.1",
    "jest": "^30.5.2",
    "playwright": "^1.63.0",
    "postcss": "^8",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.1",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  }
}
